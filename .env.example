# APPLICATION DATABASE
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@localhost:3306/ai_learning_planner

# INTEGRATION TEST DATABASE
TEST_DATABASE_URL=mysql+pymysql://<test_db_user>:<test_db_password>@localhost:3306/ai_learning_planner_test

# BACKUP DATABASE
BACKUP_DATABASE_URL=mysql+pymysql://<backup_db_user>:<backup_db_password>@localhost:3306/ai_learning_planner

# RESTORE TEST DATABASE
RESTORE_DATABASE_URL=mysql+pymysql://<restore_db_user>:<restore_db_password>@localhost:3306/ai_learning_planner_restore_test

# BROWSER TEST DATABASE
BROWSER_TEST_DATABASE_URL=mysql+pymysql://browser_test_app:<browser_test_password>@localhost:3306/ai_learning_planner_browser_test

APP_USE_BROWSER_TEST_DB=0

# SECURITY
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# FRONTEND API
API_BASE_URL=http://127.0.0.1:8001
