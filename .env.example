# Application database
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@localhost:3306/ai_learning_planner

# Dedicated integration test database
TEST_DATABASE_URL=mysql+pymysql://<test_db_user>:<test_db_password>@localhost:3306/ai_learning_planner_test

# JWT signing secret (minimum 32 characters)
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# Frontend API URL
API_BASE_URL=http://127.0.0.1:8001
