    <Exec>
      <Command>C:\WINDOWS\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
      <Arguments>-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "C:\Users\DELL\Desktop\projects and workshop\Agentic AI\ai-personalized-learning-planner\run_database_backup.ps1"</Arguments>
